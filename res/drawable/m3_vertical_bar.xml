<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#33FFFFFF" />
            <size android:height="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient
                    android:startColor="#FFE53E3E"
                    android:endColor="#FFFF8C42"
                    android:angle="0" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
