<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#44FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Library &amp; History"
            android:textColor="@color/yt_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_toLeftOf="@+id/btn_close_library"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/btn_close_library"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="✕"
            android:textColor="@color/yt_text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_close_circle"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Last Played Stream Card -->
    <LinearLayout
        android:id="@+id/card_last_played"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_section"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECENT PLAYBACK"
            android:textColor="@color/yt_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txt_lib_last_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No recent streams played yet."
            android:textColor="@color/yt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txt_lib_last_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stream URLs and videos you watch will be saved here."
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_lib_resume"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="▶ Resume"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action_pill"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_lib_external"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="📺 VLC / MPV"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_pill" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btn_lib_clear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🗑 Clear Cache"
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/btn_pill"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/btn_lib_reload"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="↻ Refresh Feed"
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/btn_pill" />
    </LinearLayout>
</LinearLayout>
