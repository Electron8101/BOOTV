<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_network"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:padding="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:textColor="@color/white"
            android:background="@color/accent_red"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />
    </LinearLayout>

    <!-- 60% Transparent Floating Settings Button -->
    <FrameLayout
        android:id="@+id/fab_settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="28dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/fab_background"
        android:alpha="0.6"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚙"
            android:textColor="@color/white"
            android:textSize="26sp" />
    </FrameLayout>

    <!-- Lower Semi-Transparent Launch Signature Popup -->
    <LinearLayout
        android:id="@+id/popup_bootloop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="42dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/popup_bootloop"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ CREATED BY BOOTLOOP ⚡"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOTV Beta v2.4"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Material 3 Floating Media Sniffer Dock -->
    <LinearLayout
        android:id="@+id/dock_video_sniffer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/m3_panel_bottom"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_stream_format_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 HLS"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/badge_beta"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/btn_dock_play_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="▶ Fullscreen"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/m3_btn_tonal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/btn_dock_pip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="❐ PiP"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/m3_chip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/btn_dock_external"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="📺 External"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/m3_chip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/btn_dock_copy"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="📋 Copy"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/m3_chip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/btn_dock_close"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:text="✕"
            android:textColor="@color/m3_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/m3_chip" />
    </LinearLayout>

    <!-- Fullscreen Video Container with Notch & Gesture Support -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <!-- Video Surface Holder (where WebView CustomView is attached) -->
        <FrameLayout
            android:id="@+id/video_surface_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Transparent gesture detection layer -->
        <View
            android:id="@+id/gesture_touch_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Material 3 Top Header App Bar -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/m3_panel_top"
            android:layout_margin="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/btn_player_close"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕ Close"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/m3_btn_tonal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <!-- Title / Channel info -->
            <TextView
                android:id="@+id/txt_player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="10dp"
                android:text="BOOTV Player"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="marquee" />

            <!-- Quality Badge -->
            <TextView
                android:id="@+id/txt_player_quality"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="HD"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/badge_beta"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginRight="8dp" />

            <!-- Signature Soul/Material Status Chip (Clock & Battery) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/m3_chip"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp">

                <TextView
                    android:id="@+id/txt_player_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_player_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 🔋 100%"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⤢ Fit"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/m3_chip"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/btn_pip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❐ PiP"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/m3_chip"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/btn_lock"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔓 Lock"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/m3_chip"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- Left Double-Tap Seek Zone (Curved Ripple Overlay - Hossain Shifat player style) -->
        <FrameLayout
            android:id="@+id/seek_zone_left"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:background="@drawable/m3_seek_zone_left"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏪"
                    android:textSize="26sp"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-10s"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right Double-Tap Seek Zone (Curved Ripple Overlay - Hossain Shifat player style) -->
        <FrameLayout
            android:id="@+id/seek_zone_right"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:background="@drawable/m3_seek_zone_right"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏩"
                    android:textSize="26sp"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+10s"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Speed Boost Badge (Top Pill - Hossain Shifat player style) -->
        <LinearLayout
            android:id="@+id/badge_speed_boost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/m3_speed_badge"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_speed_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 2.0x Speed Playing"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Glassmorphic Vertical Brightness Capsule BarPill (Left) -->
        <LinearLayout
            android:id="@+id/hud_brightness"
            android:layout_width="66dp"
            android:layout_height="170dp"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="28dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/m3_bar_pill"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="18sp"
                android:textColor="@color/white" />

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/pb_brightness"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="86dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/m3_vertical_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_brightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Glassmorphic Vertical Volume Capsule BarPill (Right) -->
        <LinearLayout
            android:id="@+id/hud_volume"
            android:layout_width="66dp"
            android:layout_height="170dp"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="28dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/m3_bar_pill"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_volume_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="18sp"
                android:textColor="@color/white" />

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/pb_volume"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="86dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/m3_vertical_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Fast Forward / Rewind Seek HUD (Center - Hossain Shifat player style) -->
        <LinearLayout
            android:id="@+id/hud_seek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/m3_panel_top"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_seek_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <TextView
                android:id="@+id/txt_seek_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[+00:00]"
                android:textColor="@color/neon_cyan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/txt_seek_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Release to Seek"
                android:textColor="@color/m3_secondary_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Action Feedback Toast/HUD -->
        <TextView
            android:id="@+id/hud_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="110dp"
            android:text="Action"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/m3_chip"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Material 3 Bottom Timeline & Media Controls Bar -->
        <LinearLayout
            android:id="@+id/player_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/m3_panel_bottom"
            android:layout_margin="12dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Material Slider / Timeline Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txt_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:splitTrack="false"
                    android:progressDrawable="@drawable/m3_seekbar_progress"
                    android:thumb="@drawable/m3_seekbar_thumb"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

                <TextView
                    android:id="@+id/txt_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/m3_secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Material Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_rewind_10"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="↺ 10s"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:background="@drawable/m3_btn_tonal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:text="▶"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/m3_btn_play_pause"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/btn_forward_10"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="↻ 10s"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:background="@drawable/m3_btn_tonal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⚡ 1.0x"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:background="@drawable/m3_chip"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/btn_fullscreen_ext_player"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📺 External"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:background="@drawable/m3_chip"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Custom In-App Keypad & Author Lock Overlay -->
    <RelativeLayout
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <!-- Circular Author Avatar -->
            <ImageView
                android:id="@+id/img_author_lock"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:src="@drawable/author_avatar"
                android:contentDescription="Author Avatar"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATED BY BOOTLOOP"
                android:textColor="@color/accent_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_lock_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter PIN to Unlock"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <!-- PIN Indicator Dots -->
            <LinearLayout
                android:id="@+id/pin_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />
            </LinearLayout>

            <!-- 3x4 Glassmorphism Numeric Keypad -->
            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <!-- Row 1 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_1"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_2"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_3"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="3"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 2 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_4"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="4"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_5"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_6"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="6"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 3 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_7"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="7"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_8"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="8"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_9"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="9"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 4 -->
                <TableRow android:gravity="center">
                    <TextView
                        android:id="@+id/key_bio"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="👆"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_0"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_del"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="⌫"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

            </TableLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Mandatory Update Lockout Screen -->
    <RelativeLayout
        android:id="@+id/layout_update_lockout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA0B0F19"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ UPDATE REQUIRED"
                android:textColor="@color/accent_red"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_lockout_version_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This version of BOOTV is no longer supported."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txt_lockout_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To ensure uninterrupted streaming and access to the latest security &amp; performance features, you must update to continue."
                android:textColor="@color/gray"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_lockout_update"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:text="⚡ Update Now"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action_pill"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_lockout_exit"
                android:layout_width="220dp"
                android:layout_height="42dp"
                android:text="Exit App"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/btn_danger_pill" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
