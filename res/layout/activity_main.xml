<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_network"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:padding="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:textColor="@color/white"
            android:background="@color/accent_red"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />
    </LinearLayout>

    <!-- 60% Transparent Floating Settings Button -->
    <FrameLayout
        android:id="@+id/fab_settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="28dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/fab_background"
        android:alpha="0.6"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚙"
            android:textColor="@color/white"
            android:textSize="26sp" />
    </FrameLayout>

    <!-- Lower Semi-Transparent Launch Signature Popup -->
    <LinearLayout
        android:id="@+id/popup_bootloop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="42dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/popup_bootloop"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ CREATED BY BOOTLOOP ⚡"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOTV Beta v2.4"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Modern Floating Glassmorphic External Player Pill -->
    <LinearLayout
        android:id="@+id/pill_external_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/btn_external_player"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📺 Play in External Player"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_stream_format_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HLS"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/badge_beta"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- Fullscreen Video Container with Notch & Gesture Support -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <!-- Host for HTML5 custom video view -->
        <FrameLayout
            android:id="@+id/video_surface_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Transparent gesture detection layer -->
        <View
            android:id="@+id/gesture_touch_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Controls Overlay Bar -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/hud_background"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/btn_player_close"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕ Close"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_rewind_10"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏪ -10s"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <!-- Dedicated Pause / Play Button in Fullscreen -->
            <TextView
                android:id="@+id/btn_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏸ Pause"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_forward_10"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏩ +10s"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⤢ Fit"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚡ 1.0x"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_lock"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔓 Lock"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/btn_pill"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_pip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❐ PiP"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/glass_button"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/btn_fullscreen_ext_player"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📺 Player"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_external_player"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Brightness Gesture HUD (Left) -->
        <LinearLayout
            android:id="@+id/hud_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="36dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hud_background"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_brightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ 80%"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/pb_brightness"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="80" />
        </LinearLayout>

        <!-- Volume Gesture HUD (Right) -->
        <LinearLayout
            android:id="@+id/hud_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="36dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hud_background"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 75%"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/pb_volume"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="75" />
        </LinearLayout>

        <!-- Fast Forward / Rewind Seek HUD (Center) -->
        <LinearLayout
            android:id="@+id/hud_seek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hud_background"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_seek_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏩ +10s"
                android:textColor="@color/seek_blue"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/txt_seek_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Release to Seek"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Action Feedback Toast/HUD -->
        <TextView
            android:id="@+id/hud_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:text="Action"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/hud_background"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Custom In-App Keypad & Author Lock Overlay -->
    <RelativeLayout
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <!-- Circular Author Avatar -->
            <ImageView
                android:id="@+id/img_author_lock"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:src="@drawable/author_avatar"
                android:contentDescription="Author Avatar"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATED BY BOOTLOOP"
                android:textColor="@color/accent_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_lock_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter PIN to Unlock"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <!-- PIN Indicator Dots -->
            <LinearLayout
                android:id="@+id/pin_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />

                <View
                    android:id="@+id/dot_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_margin="6dp" />
            </LinearLayout>

            <!-- 3x4 Glassmorphism Numeric Keypad -->
            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <!-- Row 1 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_1"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_2"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_3"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="3"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 2 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_4"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="4"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_5"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_6"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="6"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 3 -->
                <TableRow android:gravity="center" android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/key_7"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="7"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_8"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="8"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_9"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="9"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

                <!-- Row 4 -->
                <TableRow android:gravity="center">
                    <TextView
                        android:id="@+id/key_bio"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="👆"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_0"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                    <TextView
                        android:id="@+id/key_del"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:text="⌫"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/btn_keypad"
                        android:layout_margin="6dp" />
                </TableRow>

            </TableLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Mandatory Update Lockout Screen -->
    <RelativeLayout
        android:id="@+id/layout_update_lockout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA0B0F19"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ UPDATE REQUIRED"
                android:textColor="@color/accent_red"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_lockout_version_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This version of BOOTV is no longer supported."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txt_lockout_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To ensure uninterrupted streaming and access to the latest security &amp; performance features, you must update to continue."
                android:textColor="@color/gray"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_lockout_update"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:text="⚡ Update Now"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action_pill"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_lockout_exit"
                android:layout_width="220dp"
                android:layout_height="42dp"
                android:text="Exit App"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/btn_danger_pill" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
