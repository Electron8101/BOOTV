<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/dialog_background"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙ Settings"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security, Playback &amp; Preferences"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_close_settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_close_circle"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Author / App Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_section"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/img_author_settings"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/author_avatar"
                    android:contentDescription="Author Avatar"
                    android:background="@drawable/avatar_border"
                    android:padding="2dp"
                    android:layout_marginRight="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BOOTV"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v1.5.7"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/badge_version"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ CREATED BY BOOTLOOP ⚡"
                        android:textColor="@color/accent_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ad-Free • Gesture Video Player • Biometric Lock"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_telegram_owner"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="✈️ Contact Developer (t.me/BOOTLOOP1)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_telegram_pill"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Security Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_section"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐 SECURITY &amp; APP LOCK"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- PIN Protection Switch Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentLeft="true"
                    android:layout_toLeftOf="@+id/switch_pin_lock"
                    android:layout_marginRight="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password / PIN Protection"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Require PIN code when opening BOOTV"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_pin_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Buttons: Change PIN & Remove Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_change_pin"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="🔑 Change PIN Code"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action_pill"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_remove_pin"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="🗑 Remove Password / Turn Off Lock"
                    android:textColor="#FFFF453A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_danger_pill" />

                <Button
                    android:id="@+id/btn_lock_now"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="🔒 Lock App Now"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pill"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Thin inner divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Fingerprint Switch Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentLeft="true"
                    android:layout_toLeftOf="@+id/switch_fingerprint"
                    android:layout_marginRight="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fingerprint / Biometrics"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use system fingerprint sensor to unlock"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Storage & Performance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_section"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ STORAGE &amp; PERFORMANCE"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear web cache, stream cookies, and offline data to optimize app performance."
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🚀 Check for App Updates"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action_pill"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🧹 Clear Web Cache &amp; Cookies"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action_pill" />
        </LinearLayout>

        <!-- Bottom Done Button -->
        <Button
            android:id="@+id/btn_done_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Done"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_pill" />

    </LinearLayout>
</ScrollView>
