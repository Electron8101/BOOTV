<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:id="@+id/txt_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Set New PIN"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txt_pin_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter a 4 to 6 digit security PIN:"
        android:textColor="@color/gray"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edt_pin_input"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:gravity="center"
        android:textSize="22sp"
        android:textColor="@color/white"
        android:background="@drawable/input_field"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right">

        <Button
            android:id="@+id/btn_cancel_pin"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="@color/gray"
            android:background="@android:color/transparent"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_confirm_pin"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Save PIN"
            android:textColor="@color/white"
            android:background="@drawable/btn_pill"
            android:paddingLeft="18dp"
            android:paddingRight="18dp" />
    </LinearLayout>

</LinearLayout>
